# ════════════════════════════════════════════════════════════
# RERA OS — public demo environment (Supabase only)
# NEVER commit a .env file with real credentials.
# ════════════════════════════════════════════════════════════

# ── Auth mode ─────────────────────────────────────────────────────────────────
# "local"    = SQLite + email/password (offline demo, no Supabase)
# "supabase" = Supabase JWT verification (recommended for hosted demo)
AUTH_MODE=supabase

# Local-only fallback (ignored when AUTH_MODE=supabase)
LOCAL_JWT_SECRET=change-me-demo-only-secret

# ── Supabase (required for hosted demo) ───────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT (Render / many cloud hosts): do NOT use direct db.*.supabase.co:5432 —
# that host is IPv6-only and fails with "Network is unreachable".
# Use Supabase Dashboard → Database → Connection string → Session pooler (IPv4):
#   username = postgres.YOUR_PROJECT_REF  (not plain "postgres")
#   host     = aws-0-REGION.pooler.supabase.com
#   port     = 5432 (session) or 6543 (transaction)
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Demo operator (local auth + KPI reviewer access) ──────────────────────────
PRIMARY_USER_EMAIL=demo@reraos.demo
KPI_REVIEWER_EMAILS=demo@reraos.demo

# ── Optional: S3 file storage (leave blank for local uploads/) ──────────────────
S3_BUCKET=
AWS_REGION=us-east-1
