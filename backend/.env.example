# ════════════════════════════════════════════════════════════
# EstateCFO — environment variable reference
# NEVER commit a .env file with real credentials.
# ════════════════════════════════════════════════════════════

# ── Auth mode ─────────────────────────────────────────────────────────────────
# "local"   = SQLite + email/password (no Supabase, for local dev only)
# "supabase" = Supabase JWT verification (production)
AUTH_MODE=local
LOCAL_JWT_SECRET=estatecfo-local-dev-secret-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Production: set RDS_SECRET_ARN and leave DATABASE_URL blank.
#   The backend fetches credentials from Secrets Manager at startup.
#   RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:estatecfo/prod/rds-app-XXXXXX
#
# Local dev: leave both blank — SQLite at backend/data/estatecfo.db is used.
#
# CI / manual override: set DATABASE_URL directly (takes priority over RDS_SECRET_ARN).
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/estatecfo
RDS_SECRET_ARN=
DATABASE_URL=

# ── S3 file storage ───────────────────────────────────────────────────────────
# Production: set to the bucket name from Terraform outputs (outputs.tf → s3_bucket_name).
#   Files are stored in S3, URLs are pre-signed (1-hour TTL).
# Local dev: leave blank — files go to backend/uploads/ and served from /uploads/.
S3_BUCKET=

# ── AWS credentials ───────────────────────────────────────────────────────────
# Production (EC2 / ECS): DO NOT set these. The IAM role attached to your
#   compute resource provides credentials automatically — no static keys needed.
#
# Local dev / CI only (if not using an IAM role):
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Supabase Auth (production only, AUTH_MODE=supabase) ───────────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
