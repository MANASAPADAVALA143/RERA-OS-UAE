# Local demo mode — no Supabase required (default when SUPABASE_URL is empty)
AUTH_MODE=local
LOCAL_JWT_SECRET=estatecfo-local-dev-secret

# Optional: leave blank to use SQLite at backend/data/estatecfo.db
# DATABASE_URL=

# Supabase (only needed when AUTH_MODE=supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# AWS Bedrock (optional — AI narrative features)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
